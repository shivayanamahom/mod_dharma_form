<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
	<name>MOD_DHARMA_FORM</name>
	<author>Dharma Design</author>
	<creationDate>October 2026</creationDate>
	<copyright>Copyright © 2026 Dharma Design. All rights reserved.</copyright>
	<license>https://www.gnu.org/copyleft/gpl.html GNU/GPL</license>
	<version>0.1.2</version>
	<description>MOD_DHARMA_FORM_DESCRIPTION</description>
	<updateservers>
		<server type="extension" priority="1" name="Dharma Form Updates">https://raw.githubusercontent.com/shivayanamahom/mod_dharma_form/main/updates.xml</server>
	</updateservers>
	<namespace path="src">Joomla\Module\DharmaForm</namespace>
	<languages folder="language">
		<language tag="en-GB">en-GB/mod_dharma_form.ini</language>
		<language tag="en-GB">en-GB/mod_dharma_form.sys.ini</language>
		<language tag="ru-RU">ru-RU/mod_dharma_form.ini</language>
		<language tag="ru-RU">ru-RU/mod_dharma_form.sys.ini</language>
	</languages>
	<files>
		<folder module="mod_dharma_form">src</folder>
		<folder>services</folder>
		<folder>tmpl</folder>
	</files>
	<media destination="mod_dharma_form" folder="media">
		<filename>joomla.asset.json</filename>
		<filename>readme.html</filename>
		<folder>css</folder>
		<folder>js</folder>
	</media>
	<config>
		<fields name="params">

			<!-- Вкладка 1: конструктор форм -->
			<fieldset name="builder" label="MOD_DHARMA_FORM_TAB_BUILDER">
				<field
					name="fields"
					type="subform"
					label="MOD_DHARMA_FORM_FIELDS"
					description="MOD_DHARMA_FORM_FIELDS_DESC"
					multiple="true"
					min="1"
					layout="joomla.form.field.subform.repeatable"
					buttons="add,remove,move"
					groupByFieldset="false"
					default='{"fields0":{"type":"text","name":"name","label":"Ваше имя","placeholder":"","required":"1","rows":"3"},"fields1":{"type":"phone","name":"phone","label":"Телефон","placeholder":"","required":"1","rows":"3"},"fields2":{"type":"consent","name":"agree","text":"Я соглашаюсь с {link} и даю согласие на обработку моих персональных данных","link_text":"Политикой конфиденциальности","link_url":"/politika","required":"1","rows":"3"}}'
				>
					<form>
						<field
							name="type"
							type="list"
							label="MOD_DHARMA_FORM_FIELD_TYPE"
							default="text"
							validate="options"
						>
							<option value="text">MOD_DHARMA_FORM_TYPE_TEXT</option>
							<option value="email">MOD_DHARMA_FORM_TYPE_EMAIL</option>
							<option value="textarea">MOD_DHARMA_FORM_TYPE_TEXTAREA</option>
							<option value="phone">MOD_DHARMA_FORM_TYPE_PHONE</option>
							<option value="select">MOD_DHARMA_FORM_TYPE_SELECT</option>
							<option value="radio">MOD_DHARMA_FORM_TYPE_RADIO</option>
							<option value="checkboxes">MOD_DHARMA_FORM_TYPE_CHECKBOXES</option>
							<option value="file">MOD_DHARMA_FORM_TYPE_FILE</option>
							<option value="hidden">MOD_DHARMA_FORM_TYPE_HIDDEN</option>
							<option value="consent">MOD_DHARMA_FORM_TYPE_CONSENT</option>
							<option value="note">MOD_DHARMA_FORM_TYPE_NOTE</option>
						</field>
						<field
							name="name"
							type="text"
							label="MOD_DHARMA_FORM_FIELD_NAME"
							description="MOD_DHARMA_FORM_FIELD_NAME_DESC"
							hint="name"
							filter="string"
						/>
						<field
							name="label"
							type="text"
							label="MOD_DHARMA_FORM_FIELD_LABEL"
							filter="string"
							showon="type:text,email,textarea,phone,file,select,radio,checkboxes"
						/>
						<field
							name="placeholder"
							type="text"
							label="MOD_DHARMA_FORM_FIELD_PLACEHOLDER"
							filter="string"
							showon="type:text,email,textarea,phone,file,select"
						/>
						<field
							name="file_mode"
							type="list"
							label="MOD_DHARMA_FORM_FIELD_FILE_MODE"
							default="button"
							validate="options"
							showon="type:file"
						>
							<option value="button">MOD_DHARMA_FORM_FILE_MODE_BUTTON</option>
							<option value="dropzone">MOD_DHARMA_FORM_FILE_MODE_DROPZONE</option>
						</field>
						<field
							name="file_multiple"
							type="radio"
							label="MOD_DHARMA_FORM_FIELD_FILE_MULTIPLE"
							layout="joomla.form.field.radio.switcher"
							default="0"
							showon="type:file"
						>
							<option value="0">JNO</option>
							<option value="1">JYES</option>
						</field>
						<field
							name="file_accept"
							type="text"
							label="MOD_DHARMA_FORM_FIELD_FILE_ACCEPT"
							description="MOD_DHARMA_FORM_FIELD_FILE_ACCEPT_DESC"
							hint=".pdf, .doc, .docx, .jpg, .png"
							filter="string"
							showon="type:file"
						/>
						<field
							name="text"
							type="textarea"
							label="MOD_DHARMA_FORM_FIELD_CONSENT_TEXT"
							description="MOD_DHARMA_FORM_FIELD_CONSENT_TEXT_DESC"
							rows="3"
							filter="safehtml"
							showon="type:consent,note"
						/>
						<field
							name="link_text"
							type="text"
							label="MOD_DHARMA_FORM_FIELD_LINK_TEXT"
							filter="string"
							showon="type:consent"
						/>
						<field
							name="link_url"
							type="text"
							label="MOD_DHARMA_FORM_FIELD_LINK_URL"
							hint="/politika"
							filter="string"
							showon="type:consent"
						/>
						<field
							name="options"
							type="textarea"
							label="MOD_DHARMA_FORM_FIELD_OPTIONS"
							description="MOD_DHARMA_FORM_FIELD_OPTIONS_DESC"
							rows="4"
							filter="string"
							showon="type:select,radio,checkboxes"
						/>
						<field
							name="hidden_source"
							type="list"
							label="MOD_DHARMA_FORM_FIELD_HIDDEN_SOURCE"
							default="url"
							validate="options"
							showon="type:hidden"
						>
							<option value="url">MOD_DHARMA_FORM_HIDDEN_URL</option>
							<option value="title">MOD_DHARMA_FORM_HIDDEN_TITLE</option>
							<option value="custom">MOD_DHARMA_FORM_HIDDEN_CUSTOM</option>
						</field>
						<field
							name="hidden_value"
							type="text"
							label="MOD_DHARMA_FORM_FIELD_HIDDEN_VALUE"
							filter="string"
							showon="type:hidden[AND]hidden_source:custom"
						/>
						<field
							name="required"
							type="radio"
							label="MOD_DHARMA_FORM_FIELD_REQUIRED"
							layout="joomla.form.field.radio.switcher"
							default="0"
							showon="type:text,email,textarea,phone,file,select,radio,checkboxes,consent"
						>
							<option value="0">JNO</option>
							<option value="1">JYES</option>
						</field>
						<field
							name="mask"
							type="text"
							label="MOD_DHARMA_FORM_FIELD_MASK"
							description="MOD_DHARMA_FORM_FIELD_MASK_DESC"
							hint="+7 (###) ###-##-##"
							filter="string"
							showon="type:phone"
						/>
						<field
							name="rows"
							type="number"
							label="MOD_DHARMA_FORM_FIELD_ROWS"
							default="3"
							min="1"
							max="20"
							filter="integer"
							showon="type:textarea"
						/>
						<field
							name="error"
							type="text"
							label="MOD_DHARMA_FORM_FIELD_ERROR"
							description="MOD_DHARMA_FORM_FIELD_ERROR_DESC"
							filter="string"
							showon="type:text,email,textarea,phone,file,select,radio,checkboxes,consent"
						/>
					</form>
				</field>
			</fieldset>

			<!-- Вкладка 2: настройки -->
			<fieldset name="settings" label="MOD_DHARMA_FORM_TAB_SETTINGS">
				<field
					name="mode"
					type="list"
					label="MOD_DHARMA_FORM_MODE"
					default="simple"
					validate="options"
				>
					<option value="simple">MOD_DHARMA_FORM_MODE_SIMPLE</option>
					<option value="modal">MOD_DHARMA_FORM_MODE_MODAL</option>
				</field>
				<field
					name="trigger_class"
					type="text"
					label="MOD_DHARMA_FORM_TRIGGER_CLASS"
					description="MOD_DHARMA_FORM_TRIGGER_CLASS_DESC"
					hint="callback"
					default="callback"
					filter="string"
					showon="mode:modal"
				/>
				<field
					name="trigger_text"
					type="text"
					label="MOD_DHARMA_FORM_TRIGGER_TEXT"
					description="MOD_DHARMA_FORM_TRIGGER_TEXT_DESC"
					filter="string"
					showon="mode:modal"
				/>

				<field name="note_texts" type="note" label="MOD_DHARMA_FORM_NOTE_TEXTS" class="alert alert-info" />
				<field
					name="title"
					type="text"
					label="MOD_DHARMA_FORM_TITLE"
					filter="string"
				/>
				<field
					name="lead"
					type="textarea"
					label="MOD_DHARMA_FORM_LEAD"
					rows="3"
					filter="safehtml"
				/>
				<field
					name="show_labels"
					type="radio"
					label="MOD_DHARMA_FORM_SHOW_LABELS"
					layout="joomla.form.field.radio.switcher"
					default="0"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>

				<field name="note_button" type="note" label="MOD_DHARMA_FORM_NOTE_BUTTON" class="alert alert-info" />
				<field
					name="button_text"
					type="text"
					label="MOD_DHARMA_FORM_BUTTON_TEXT"
					default="Отправить заявку"
					filter="string"
				/>
				<field
					name="button_class"
					type="text"
					label="MOD_DHARMA_FORM_BUTTON_CLASS"
					default="knopka ripple-hover"
					filter="string"
				/>
				<field
					name="file_button_class"
					type="text"
					label="MOD_DHARMA_FORM_FILE_BUTTON_CLASS"
					default="knopka2"
					filter="string"
				/>
				<field
					name="button_arrow"
					type="radio"
					label="MOD_DHARMA_FORM_BUTTON_ARROW"
					layout="joomla.form.field.radio.switcher"
					default="1"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>

				<field name="note_after" type="note" label="MOD_DHARMA_FORM_NOTE_AFTER" description="MOD_DHARMA_FORM_NOTE_AFTER_DESC" class="alert alert-info" />
				<field
					name="after_action"
					type="list"
					label="MOD_DHARMA_FORM_AFTER_ACTION"
					default="default"
					validate="options"
				>
					<option value="default">MOD_DHARMA_FORM_AFTER_DEFAULT</option>
					<option value="message">MOD_DHARMA_FORM_AFTER_MESSAGE</option>
					<option value="redirect">MOD_DHARMA_FORM_AFTER_REDIRECT</option>
				</field>
				<field
					name="after_title"
					type="text"
					label="MOD_DHARMA_FORM_AFTER_TITLE"
					default="Спасибо!"
					filter="string"
					showon="after_action:message"
				/>
				<field
					name="after_message"
					type="textarea"
					label="MOD_DHARMA_FORM_AFTER_TEXT"
					rows="3"
					default="Заявка отправлена. Мы свяжемся с вами в ближайшее время."
					filter="safehtml"
					showon="after_action:message"
				/>
				<field
					name="after_redirect_menu"
					type="menuitem"
					label="MOD_DHARMA_FORM_AFTER_REDIRECT_MENU"
					filter="integer"
					showon="after_action:redirect"
				>
					<option value="0">MOD_DHARMA_FORM_AFTER_REDIRECT_MENU_NONE</option>
				</field>
				<field
					name="after_redirect_url"
					type="text"
					label="MOD_DHARMA_FORM_AFTER_REDIRECT_URL"
					description="MOD_DHARMA_FORM_AFTER_REDIRECT_URL_DESC"
					hint="/spasibo"
					filter="string"
					showon="after_action:redirect"
				/>
				<field
					name="after_redirect_delay"
					type="number"
					label="MOD_DHARMA_FORM_AFTER_REDIRECT_DELAY"
					description="MOD_DHARMA_FORM_AFTER_DELAY_DESC"
					default="0"
					min="0"
					max="60"
					filter="integer"
					showon="after_action:redirect"
				/>
				<field
					name="after_close"
					type="radio"
					label="MOD_DHARMA_FORM_AFTER_CLOSE"
					layout="joomla.form.field.radio.switcher"
					default="1"
					showon="mode:modal[AND]after_action:default,message"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="after_close_delay"
					type="number"
					label="MOD_DHARMA_FORM_AFTER_CLOSE_DELAY"
					description="MOD_DHARMA_FORM_AFTER_DELAY_DESC"
					default="3"
					min="0"
					max="60"
					filter="integer"
					showon="mode:modal[AND]after_action:default,message[AND]after_close:1"
				/>

				<field name="note_goal" type="note" label="MOD_DHARMA_FORM_NOTE_GOAL" description="MOD_DHARMA_FORM_NOTE_GOAL_DESC" class="alert alert-info" />
				<field
					name="goal_name"
					type="text"
					label="MOD_DHARMA_FORM_GOAL_NAME"
					description="MOD_DHARMA_FORM_GOAL_NAME_DESC"
					hint="callback_sent"
					filter="string"
				/>
				<field
					name="goal_ym_id"
					type="number"
					label="MOD_DHARMA_FORM_GOAL_YM"
					description="MOD_DHARMA_FORM_GOAL_YM_DESC"
					min="0"
					filter="integer"
					showon="goal_name!:"
				/>

				<field name="note_rf" type="note" label="MOD_DHARMA_FORM_NOTE_RF" description="MOD_DHARMA_FORM_NOTE_RF_DESC" class="alert alert-info" />
				<field
					name="rf_subject"
					type="text"
					label="MOD_DHARMA_FORM_RF_SUBJECT"
					description="MOD_DHARMA_FORM_RF_SUBJECT_DESC"
					filter="string"
				/>
				<field
					name="rf_target"
					type="text"
					label="MOD_DHARMA_FORM_RF_TARGET"
					description="MOD_DHARMA_FORM_RF_TARGET_DESC"
					filter="string"
				/>
				<field
					name="rf_text"
					type="text"
					label="MOD_DHARMA_FORM_RF_TEXT"
					description="MOD_DHARMA_FORM_RF_TEXT_DESC"
					filter="string"
				/>

				<field name="note_adv" type="note" label="MOD_DHARMA_FORM_NOTE_ADV" class="alert alert-info" />
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					class="form-select"
					validate="moduleLayout"
				/>
				<field
					name="moduleclass_sfx"
					type="textarea"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					rows="2"
					validate="CssIdentifier"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
